# Base de datos (el nombre debe coincidir con el de DB_URL)
DB_URL=jdbc:postgresql://localhost:5432/assetguard
DB_USERNAME=postgres
DB_PASSWORD=

# Bootstrap: la cuenta se crea solo si no existe (12-20 caracteres).
# Si ya existe, su contrasena y estado no se modifican en cada arranque.
BOOTSTRAP_ADMIN_EMAIL=admin@globalnet.com
BOOTSTRAP_ADMIN_NAME=Administrador AssetGuard
BOOTSTRAP_ADMIN_PASSWORD=

# Sesiones y CORS/CSRF
SESSION_TTL_HOURS=8
SESSION_COOKIE_SECURE=false
APP_ORIGIN=http://localhost:3000

# Interfaz GraphiQL (desactivar en produccion)
GRAPHIQL_ENABLED=true

# URL del backend usada por el frontend
BACKEND_URL=http://localhost:8080